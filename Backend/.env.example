# MongoDB connection (local MongoDB or MongoDB Atlas)
MONGO_DB_URI=mongodb://127.0.0.1:27017/linkpulse
PORT=8080
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Public origin of the backend, used to build short URLs and QR codes
baseUrl=http://localhost:8080
# Frontend origins; comma-separated when deployed
CLIENT_URLS=http://localhost:5173
# Optional Redis URL. Leave blank to disable Redis.
REDIS_URL2=
